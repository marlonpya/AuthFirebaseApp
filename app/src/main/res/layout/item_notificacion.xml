<?xml version="1.0" encoding="utf-8"?>
<!-- Item de la lista de notificaciones: punto de "no leída" + título/cuerpo/fecha + icono eliminar. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Punto azul indicador de "no leída"; se oculta (INVISIBLE) cuando ya se leyó. -->
        <View
            android:id="@+id/viewIndicadorNoLeida"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/holo_blue_light"
            android:contentDescription="@string/notificaciones_no_leida_descripcion"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTituloNotificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Nueva tarea asignada" />

            <TextView
                android:id="@+id/textCuerpoNotificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Tienes una nueva tarea pendiente en el curso de Kotlin" />

            <TextView
                android:id="@+id/textFechaNotificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                tools:text="30/07/2026 14:35" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/botonEliminarNotificacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notificaciones_accion_eliminar"
            android:src="@android:drawable/ic_menu_delete" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
